# Copy to .env (never commit). Everything runs without keys (deterministic fallbacks).
MONGODB_URI=mongodb://localhost:27027/?directConnection=true
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
VOYAGE_API_KEY=
PACE=1.0
# Optional: run the Gardener's throwaway CI sandbox on a different MongoDB (falls back to MONGODB_URI if unreachable)
# GARDENER_SANDBOX_URI=mongodb://localhost:27027/?directConnection=true
# Optional LangSmith tracing (off unless both are set; see README "Tracing (LangSmith)")
# LANGSMITH_TRACING=1
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=legacy-siege
